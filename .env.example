# تنظیمات Telegram Bot
# توضیح: این فایل شامل متغیرهای محیطی لازم برای اجرای برنامه است
# برای اجرای محلی، یک کپی از این فایل تحت نام .env ایجاد کنید و مقادیر را وارد کنید

# توکن ربات تلگرام
# نحوه دریافت: به @BotFather در تلگرام پیام دهید و دستور /newbot را اجرا کنید
BOT_TOKEN=your_bot_token_here

# آیدی کانال یا چت
# برای کانال: @username یا chat_id (معمولا منفی است)
# برای دریافت: ربات را به کانال اضافه کنید و یک پیام ارسال کنید، سپس لینک زیر را بررسی کنید:
# https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
CHAT_ID=your_chat_id_here
